# ===== 云端大模型（默认，OpenAI 兼容接口）=====
OPENAI_BASE_URL=https://api.okrouter.ai/v1
OPENAI_MODEL=gpt-5.4
OPENAI_API_KEY=
SKILL_RECOMMENDER_USE_LLM=true

# ===== Ollama 本地大模型（可选）=====
# 安装 Ollama（https://ollama.com）并拉取模型后，取消下面注释即可切换为本地推理，
# 不再消耗云端 API 额度，数据不出本机：
#   ollama pull qwen2.5:3b
#   或用仓库内脚本一键安装（含 16K 上下文变体，处理长文档更稳）：
#   powershell -ExecutionPolicy Bypass -File scripts/setup-ollama.ps1
#
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b-16k
# OLLAMA_API_KEY=ollama
#
# 说明：
# - 启用 OLLAMA_BASE_URL 后，7 个 LLM 路由（recommend/run/translate/editor-ai/
#   effect-test/material-classify/discovery）全部走本地 Ollama 的 OpenAI 兼容端点
# - 本地 CPU 推理较慢，超时会自动放宽到 5 分钟；也可用 LLM_TIMEOUT_MS 手动指定（毫秒）
# - 纯 CPU（无独立显卡）建议用 qwen2.5:1.5b / qwen2.5:3b 等小模型
# - 强机器（>= 32GB 内存或 >= 24GB 显存）可换 qwen3.8（约 18GB），在 setup 脚本中解锁
# LLM_TIMEOUT_MS=300000
